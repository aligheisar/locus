{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "assist": {
    "enabled": true,
    "includes": ["./src/**", "!src/components/ui/**"],
    "actions": {
      "source": {
        "preset": "recommended",
        "useSortedAttributes": "on",
        "useSortedEnumMembers": "on",
        "useSortedInterfaceMembers": "on",
        "useSortedPackageJson": "on",
        "useSortedProperties": "on",
        "useSortedSelectionSet": "on",
        "useSortedTypeFields": "on",
        "organizeImports": {
          "level": "on",
          "options": {
            "identifierOrder": "natural",
            "groups": [
              ":NODE:",
              ":BUN:",
              ":URL:",

              ":BLANK_LINE:",

              "react",
              "react/**",
              "react-dom",
              "react-dom/**",
              "next",
              "next/**",
              ":PACKAGE:",
              ":PACKAGE_WITH_PROTOCOL:",

              ":BLANK_LINE:",

              "@/constants/**",
              "@/config/**",
              "@/lib/**",
              "@/schemas/**",
              "@/utils/**",
              "@/api/**",
              "@/types/**",
              "@/store/**",
              "@/context/**",
              "@/hooks/**",
              "@/components/**",

              ":BLANK_LINE:",

              "@/server/constants/**",
              "@/server/config/**",
              "@/server/lib/**",
              "@/server/utils/**",
              "@/server/db/**",
              "@/server/repository/**",
              "@/server/service/**",
              "@/server/containers/**",
              "@/server/actions/**",
              "@/server/**",

              ":BLANK_LINE:",

              "@/features/*/constants/**",
              "@/features/*/config/**",
              "@/features/*/lib/**",
              "@/features/*/schemas/**",
              "@/features/*/utils/**",
              "@/features/*/api/**",
              "@/features/*/types/**",
              "@/features/*/store/**",
              "@/features/*/context/**",
              "@/features/*/hooks/**",
              "@/features/*/components/**",
              "@/features/*/**",

              ":BLANK_LINE:",

              "@/widgets/*/constants/**",
              "@/widgets/*/config/**",
              "@/widgets/*/lib/**",
              "@/widgets/*/schemas/**",
              "@/widgets/*/utils/**",
              "@/widgets/*/api/**",
              "@/widgets/*/types/**",
              "@/widgets/*/store/**",
              "@/widgets/*/context/**",
              "@/widgets/*/hooks/**",
              "@/widgets/*/components/**",
              "@/widgets/*/**",

              ":BLANK_LINE:",

              ":ALIAS:",

              ":BLANK_LINE:",

              ":PATH:"
            ]
          }
        },
        "useSortedKeys": {
          "level": "on",
          "options": {
            "groupByNesting": true,
            "sortOrder": "natural"
          }
        }
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "files": {
    "ignoreUnknown": true
  },
  "formatter": {
    "bracketSpacing": true,
    "enabled": true,
    "expand": "auto",
    "includes": ["./src/**", "!src/components/ui/**"],
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "jsxRuntime": "transparent",
    "formatter": {
      "arrowParentheses": "always",
      "jsxQuoteStyle": "double",
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    },
    "parser": {
      "jsxEverywhere": false
    }
  },
  "json": {
    "formatter": {
      "expand": "auto",
      "trailingCommas": "none"
    }
  },
  "linter": {
    "enabled": true,
    "includes": ["./src/**", "!src/components/ui/**"],
    "domains": {
      "next": "recommended",
      "project": "recommended",
      "react": "recommended",
      "tailwind": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noImportantStyles": "off"
      },
      "nursery": {
        "useSortedClasses": {
          "fix": "safe",
          "level": "on",
          "options": {
            "attributes": ["className"],
            "functions": ["cn", "clsx", "cva", "tw", "tw.*"]
          }
        }
      },
      "style": {
        "useImportType": {
          "fix": "safe",
          "level": "on",
          "options": {
            "style": "auto"
          }
        }
      }
    }
  },
  "vcs": {
    "clientKind": "git",
    "defaultBranch": "main",
    "enabled": true,
    "useIgnoreFile": true
  }
}
